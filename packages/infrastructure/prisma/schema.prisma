  isoCode    String   @unique
  name       String
  nameAr     String?
  nativeName String?
  direction  String
  isActive   Boolean  @default(true)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  courses    Course[] @relation("CourseLearningLanguageReference")
  scholarships Scholarship[] @relation("ScholarshipStudyLanguage")

  @@index([isActive])
  @@index([name])
  @@index([direction])
}

model ReferenceCity {
  id                     String                @id @default(uuid())
  countryIso2Code        String
  name                   String
  nameAr                 String?
  region                 String?
  timezone               String?
  latitude               Float?
  longitude              Float?
  isActive               Boolean               @default(true)
  metadata               Json?
  administrativeRegionId String?
  administrativeRegion   AdministrativeRegion? @relation(fields: [administrativeRegionId], references: [id])
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  universities           University[]
  universityCampuses     UniversityCampus[]

  @@index([countryIso2Code])
  @@index([countryIso2Code, name])
  @@index([region])
  @@index([isActive])
  @@index([timezone])
  @@index([administrativeRegionId])
}

model AdministrativeRegion {
  id                 String             @id @default(uuid())
  countryIso2Code    String
  regionCode         String
  name               String
  nameAr             String?
  localName          String?
  regionType         String?
  sourceType         String?
  verificationStatus String?
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  cities             ReferenceCity[]
  universities       University[]
  universityCampuses UniversityCampus[]

  @@unique([countryIso2Code, regionCode])
  @@index([countryIso2Code])
  @@index([regionCode])
}

// --- Degree Level Foundation (Phase 08) ---
model DegreeLevel {
  id            String @id @default(uuid())
  canonicalCode String @unique
  nameEn        String
  nameAr        String
  displayRank   Int    @default(0)
  status        String @default("ACTIVE")
  aliases       Json?
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  majorProfiles                        MajorLevelProfile[]
  internationalTestDegreeRelationships InternationalTestDegreeRelationship[]
  universityPrograms                   UniversityAcademicProgram[]
  scholarshipTargets                   ScholarshipDegreeTarget[]             @relation("ScholarshipDegreeTargetDegree")
  scholarshipEligibility               ScholarshipEligibilityItem[]          @relation("ScholarshipEligibilityDegree")
}

// --- Academic Taxonomy Foundation (Phase 08) ---

model AcademicTaxonomyNode {
  id               String   @id @default(uuid())
  deterministicKey String   @unique
  nodeType         String
  canonicalCode    String
  canonicalName    String
  description      String?
  status           String   @default("DRAFT")
  standardType     String   @default("CUSTOM_NATIONAL")
  standardCode     String?
  localizedNames   Json?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parentEdges                    AcademicTaxonomyEdge[]                          @relation("AcademicTaxonomyParentNode")
  childEdges                     AcademicTaxonomyEdge[]                          @relation("AcademicTaxonomyChildNode")
  aliases                        AcademicTaxonomyAlias[]
  sourceMappings                 AcademicStandardMapping[]                       @relation("AcademicStandardMappingSourceNode")
  targetMappings                 AcademicStandardMapping[]                       @relation("AcademicStandardMappingTargetNode")
  internationalTestRelationships InternationalTestAcademicTaxonomyRelationship[]
  majorAcademicFieldLinks        Major[]                                         @relation("MajorAcademicField")
  majorDisciplineLinks           Major[]                                         @relation("MajorDiscipline")
  majorProfileAcademicFieldLinks MajorLevelProfile[]                             @relation("MajorProfileAcademicField")
  majorProfileDisciplineLinks    MajorLevelProfile[]                             @relation("MajorProfileDiscipline")
  majorClassificationMappings    MajorClassificationMapping[]                    @relation("MajorClassificationTaxonomyNode")
  courseTaxonomyResolutions      CourseTaxonomyResolution[]                       @relation("CourseTaxonomyResolutionChosenNode")
  courseTaxonomyLinks            CourseAcademicTaxonomyLink[]
  courseMajorProjections         CourseMajorProjection[]

  @@unique([nodeType, canonicalCode, standardType], name: "academicTaxonomyCanonicalKey")
  @@index([nodeType])
  @@index([status])
  @@index([standardType, standardCode])
  @@index([canonicalCode])
  @@index([canonicalName])
}

model AcademicTaxonomyEdge {
  id           String   @id @default(uuid())
  parentNodeId String
  childNodeId  String
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  parentNode AcademicTaxonomyNode @relation("AcademicTaxonomyParentNode", fields: [parentNodeId], references: [id], onDelete: Restrict)
  childNode  AcademicTaxonomyNode @relation("AcademicTaxonomyChildNode", fields: [childNodeId], references: [id], onDelete: Restrict)

  @@unique([parentNodeId, childNodeId])
  @@index([parentNodeId])
  @@index([childNodeId])
  @@index([isPrimary])
}

model AcademicTaxonomyAlias {
  id              String   @id @default(uuid())
  nodeId          String
  locale          String?
  alias           String
  normalizedAlias String
  createdAt       DateTime @default(now())

  node AcademicTaxonomyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, locale, normalizedAlias])
  @@index([nodeId])
  @@index([normalizedAlias])
  @@index([locale, normalizedAlias])
}

model AcademicStandardMapping {
  id             String   @id @default(uuid())
  sourceNodeId   String
  targetNodeId   String
  sourceStandard String
  targetStandard String
  strength       String
  confidence     Float?
  notes          String?
  createdAt      DateTime @default(now())

  sourceNode AcademicTaxonomyNode @relation("AcademicStandardMappingSourceNode", fields: [sourceNodeId], references: [id], onDelete: Restrict)
  targetNode AcademicTaxonomyNode @relation("AcademicStandardMappingTargetNode", fields: [targetNodeId], references: [id], onDelete: Restrict)

  @@unique([sourceNodeId, targetNodeId, sourceStandard, targetStandard])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@index([sourceStandard, targetStandard])
  @@index([strength])
}

model SessionRecord {
  id               String    @id @default(uuid())
  identityId       String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  identity IdentityRecord @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([expiresAt])
}
