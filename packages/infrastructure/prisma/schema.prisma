  scholarshipEligibility ScholarshipEligibilityItem[] @relation("ScholarshipEligibilityCountry")
  externalCourseProviders ExternalCourseProvider[]       @relation("ExternalCourseProviderHeadquartersCountry")
  internationalTestCountryRelationships InternationalTestCountryRelationship[]

  @@index([region])
  @@index([isActive])
  @@index([name])
}

model ReferenceCurrency {
  id                              String                           @id @default(uuid())
  isoCode                         String                           @unique
  numericCode                     String?
  name                            String
  nameAr                          String?
  symbol                          String?
  minorUnit                       Int?
  isActive                        Boolean                          @default(true)
  metadata                        Json?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  universityTuitionProfiles       UniversityTuitionProfile[]       @relation("UniversityTuitionCurrency")
  universityAccommodationProfiles UniversityAccommodationProfile[] @relation("UniversityAccommodationCurrency")
  universityLivingCostProfiles    UniversityAccommodationProfile[] @relation("UniversityAccommodationLivingCostCurrency")
  scholarshipBenefits             ScholarshipBenefit[]             @relation("ScholarshipBenefitCurrency")
  internationalTestFees           InternationalTestFeeMetadata[]

  @@index([isActive])
  @@index([name])
}

model ReferenceLanguage {
  id         String   @id @default(uuid())
  isoCode    String   @unique
  name       String
  nameAr     String?
  nativeName String?
  direction  String
  isActive   Boolean  @default(true)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  courses    Course[] @relation("CourseLearningLanguageReference")
  scholarships Scholarship[] @relation("ScholarshipStudyLanguage")
  internationalTestLanguageRelationships InternationalTestLanguageRelationship[]

  @@index([isActive])
  @@index([name])
  @@index([direction])
}

model ReferenceCity {
  id                     String                @id @default(uuid())
  canonicalIdentityKey   String?               @unique
  countryIso2Code        String
  name                   String
  nameAr                 String?
  region                 String?
  timezone               String?
  latitude               Float?
  longitude              Float?
  isActive               Boolean               @default(true)
  metadata               Json?
  administrativeRegionId String?
  administrativeRegion   AdministrativeRegion? @relation(fields: [administrativeRegionId], references: [id])
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  universities           University[]
  universityCampuses     UniversityCampus[]

  @@index([countryIso2Code])
  @@index([countryIso2Code, name])
  @@index([region])
  @@index([isActive])
  @@index([timezone])
  @@index([administrativeRegionId])
}

model AdministrativeRegion {
  id                 String             @id @default(uuid())
  countryIso2Code    String
  regionCode         String
  name               String
  nameAr             String?
  localName          String?
  regionType         String?
  sourceType         String?
  verificationStatus String?
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  cities             ReferenceCity[]
  universities       University[]
  universityCampuses UniversityCampus[]

  @@unique([countryIso2Code, regionCode])
  @@index([countryIso2Code])
  @@index([regionCode])
}

// --- Degree Level Foundation (Phase 08) ---
model DegreeLevel {
  id            String @id @default(uuid())
  canonicalCode String @unique
  nameEn        String
  nameAr        String
  displayRank   Int    @default(0)
  status        String @default("ACTIVE")
  aliases       Json?
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  majorProfiles                        MajorLevelProfile[]
  internationalTestDegreeRelationships InternationalTestDegreeRelationship[]
  universityPrograms                   UniversityAcademicProgram[]
  scholarshipTargets                   ScholarshipDegreeTarget[]             @relation("ScholarshipDegreeTargetDegree")
  scholarshipEligibility               ScholarshipEligibilityItem[]          @relation("ScholarshipEligibilityDegree")
}

// --- Academic Taxonomy Foundation (Phase 08) ---

model AcademicTaxonomyNode {
  id               String   @id @default(uuid())
  deterministicKey String   @unique
  nodeType         String
  canonicalCode    String
  canonicalName    String
  description      String?
  status           String   @default("DRAFT")
  standardType     String   @default("CUSTOM_NATIONAL")
  standardCode     String?
  localizedNames   Json?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parentEdges                    AcademicTaxonomyEdge[]                          @relation("AcademicTaxonomyParentNode")
  childEdges                     AcademicTaxonomyEdge[]                          @relation("AcademicTaxonomyChildNode")
  aliases                        AcademicTaxonomyAlias[]
  sourceMappings                 AcademicStandardMapping[]                       @relation("AcademicStandardMappingSourceNode")
  targetMappings                 AcademicStandardMapping[]                       @relation("AcademicStandardMappingTargetNode")
  internationalTestRelationships InternationalTestAcademicTaxonomyRelationship[]
  majorAcademicFieldLinks        Major[]                                         @relation("MajorAcademicField")
  majorDisciplineLinks           Major[]                                         @relation("MajorDiscipline")
  majorProfileAcademicFieldLinks MajorLevelProfile[]                             @relation("MajorProfileAcademicField")
  majorProfileDisciplineLinks    MajorLevelProfile[]                             @relation("MajorProfileDiscipline")
  majorClassificationMappings    MajorClassificationMapping[]                    @relation("MajorClassificationTaxonomyNode")
  courseTaxonomyResolutions      CourseTaxonomyResolution[]                       @relation("CourseTaxonomyResolutionChosenNode")
  courseTaxonomyLinks            CourseAcademicTaxonomyLink[]
  courseMajorProjections         CourseMajorProjection[]

  @@unique([nodeType, canonicalCode, standardType], name: "academicTaxonomyCanonicalKey")
  @@index([nodeType])
  @@index([status])
  @@index([standardType, standardCode])
  @@index([canonicalCode])
  @@index([canonicalName])
}

model AcademicTaxonomyEdge {
  id           String   @id @default(uuid())
  parentNodeId String
  childNodeId  String
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  parentNode AcademicTaxonomyNode @relation("AcademicTaxonomyParentNode", fields: [parentNodeId], references: [id], onDelete: Restrict)
  childNode  AcademicTaxonomyNode @relation("AcademicTaxonomyChildNode", fields: [childNodeId], references: [id], onDelete: Restrict)

  @@unique([parentNodeId, childNodeId])
  @@index([parentNodeId])
  @@index([childNodeId])
  @@index([isPrimary])
}

model AcademicTaxonomyAlias {
  id              String   @id @default(uuid())
  nodeId          String
  locale          String?
  alias           String
  normalizedAlias String
  createdAt       DateTime @default(now())

  node AcademicTaxonomyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, locale, normalizedAlias])
  @@index([nodeId])
  @@index([normalizedAlias])
  @@index([locale, normalizedAlias])
}

model AcademicStandardMapping {
  id             String   @id @default(uuid())
  sourceNodeId   String
  targetNodeId   String
  sourceStandard String
  targetStandard String
  strength       String
  confidence     Float?
  notes          String?
  createdAt      DateTime @default(now())

  sourceNode AcademicTaxonomyNode @relation("AcademicStandardMappingSourceNode", fields: [sourceNodeId], references: [id], onDelete: Restrict)
  targetNode AcademicTaxonomyNode @relation("AcademicStandardMappingTargetNode", fields: [targetNodeId], references: [id], onDelete: Restrict)

  @@unique([sourceNodeId, targetNodeId, sourceStandard, targetStandard])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@index([sourceStandard, targetStandard])
  @@index([strength])
}

model SessionRecord {
  id               String    @id @default(uuid())
  identityId       String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  identity IdentityRecord @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([expiresAt])
}

// --- Phase 17: Enterprise AI Platform (provider-neutral source contracts) ---

model AIRegistryRecord {
  id               String   @id @default(uuid())
  resourceType     String
  key              String
  status           String   @default("DRAFT")
  providerKey      String?
  capabilityKey    String?
  consumerKey      String?
  secretReference  String?
  configuration    Json
  createdBy        String
  updatedBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([resourceType, key])
  @@index([resourceType, status])
  @@index([providerKey])
  @@index([capabilityKey])
  @@index([consumerKey])
}

model AIPromptVersionRecord {
  id            String   @id @default(uuid())
  promptKey     String
  version       Int
  template      String
  inputSchema   Json?
  outputSchema  Json?
  checksum      String
  status        String   @default("DRAFT")
  createdBy     String
  approvedBy    String?
  createdAt     DateTime @default(now())
  deployments   AIPromptDeploymentRecord[]

  @@unique([promptKey, version])
  @@index([promptKey, status])
}

model AIPromptDeploymentRecord {
  id            String   @id @default(uuid())
  promptKey     String
  version       Int
  environment   String   @default("PRODUCTION")
  status        String   @default("ACTIVE")
  deployedBy    String
  deployedAt    DateTime @default(now())
  retiredAt     DateTime?
  promptVersion AIPromptVersionRecord @relation(fields: [promptKey, version], references: [promptKey, version], onDelete: Restrict)

  @@index([promptKey, environment, status])
}

model AIExecutionRecord {
  id                    String   @id @default(uuid())
  publicId              String   @unique
  traceId               String
  idempotencyKeyHash    String?
  consumerKey           String
  capabilityKey         String
  purpose               String
  promptKey             String
  promptVersion         Int?
  providerKey           String?
  modelKey              String?
  status                String
  safetyDecision        String
  dataClassification    String   @default("INTERNAL")
  inputPreview          String?
  outputPreview         String?
  inputTokens           Int      @default(0)
  outputTokens          Int      @default(0)
  estimatedCost         Decimal? @db.Decimal(18, 8)
  actualCost            Decimal? @db.Decimal(18, 8)
  currency              String?
  errorCode             String?
  errorMessage          String?
  requesterReferenceId  String?
  sourceDomain          String?
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  spans                 AIExecutionSpanRecord[]
  usageRecords          AIUsageRecord[]
  asyncJobs             AIAsyncJobRecord[]

  @@unique([consumerKey, idempotencyKeyHash])
  @@index([traceId])
  @@index([status, createdAt])
  @@index([consumerKey, createdAt])
  @@index([providerKey, modelKey, createdAt])
}

model AIAsyncJobRecord {
  id                    String   @id @default(uuid())
  publicId              String   @unique
  requesterReferenceId  String
  consumerKey           String
  capabilityKey         String
  status                String   @default("QUEUED")
  payloadCiphertext     String
  payloadIv             String
  payloadAuthTag        String
  payloadKeyVersion     String
  attempts              Int      @default(0)
  maxAttempts           Int      @default(3)
  nextAttemptAt         DateTime?
  lockedAt              DateTime?
  lockedBy              String?
  executionPublicId     String?
  errorCode             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  completedAt           DateTime?
  execution             AIExecutionRecord? @relation(fields: [executionPublicId], references: [publicId], onDelete: Restrict)

  @@index([status, nextAttemptAt, createdAt])
  @@index([consumerKey, createdAt])
  @@index([requesterReferenceId, createdAt])
}

model AIExecutionSpanRecord {
  id                 String   @id @default(uuid())
  executionPublicId  String
  traceId            String
  name               String
  status             String
  startedAt          DateTime
  completedAt        DateTime?
  durationMs         Int?
  attributes         Json?
  execution          AIExecutionRecord @relation(fields: [executionPublicId], references: [publicId], onDelete: Restrict)

  @@index([executionPublicId, startedAt])
  @@index([traceId])
}

model AIUsageRecord {
  id                 String   @id @default(uuid())
  executionPublicId  String
  consumerKey        String
  providerKey        String
  modelKey           String
  inputTokens        Int
  outputTokens       Int
  cost               Decimal  @db.Decimal(18, 8)
  currency           String
  priceSnapshotKey   String?
  pricingEffectiveFrom DateTime?
  costKind           String   @default("UNKNOWN")
  metadata           Json?
  createdAt          DateTime @default(now())
  execution          AIExecutionRecord @relation(fields: [executionPublicId], references: [publicId], onDelete: Restrict)

  @@unique([executionPublicId, providerKey, modelKey])
  @@index([consumerKey, createdAt])
  @@index([providerKey, modelKey, createdAt])
}

model AIWorkflowRunRecord {
  id               String   @id @default(uuid())
  publicId         String   @unique
  workflowKey      String
  workflowVersion  Int
  status           String
  traceId          String
  inputReferenceHash String
  outputReferenceHash String?
  currentStep      String?
  errorMessage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  steps            AIWorkflowStepRunRecord[]

  @@index([workflowKey, status, createdAt])
  @@index([traceId])
}

model AIWorkflowStepRunRecord {
  id             String   @id @default(uuid())
  runPublicId    String
  stepKey        String
  executionId    String?
  status         String
  attempt        Int      @default(1)
  inputReferenceHash  String?
  outputReferenceHash String?
  errorMessage   String?
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  run            AIWorkflowRunRecord @relation(fields: [runPublicId], references: [publicId], onDelete: Restrict)

  @@unique([runPublicId, stepKey, attempt])
  @@index([runPublicId, status])
}

model AIEvaluationRunRecord {
  id               String   @id @default(uuid())
  publicId         String   @unique
  evaluationKey    String
  status           String
  promptVersion    Int?
  modelKey         String?
  passed           Int      @default(0)
  failed           Int      @default(0)
  safetyFailures   Int      @default(0)
  score            Float?
  results          Json?
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime @default(now())
  completedAt      DateTime?

  @@index([evaluationKey, status, createdAt])
}

model AIKnowledgeSourceRecord {
  id                 String   @id @default(uuid())
  indexKey           String
  sourceType         String
  sourceReferenceId  String
  sourceVersion      String?
  checksum           String
  locale             String?
  status             String   @default("PENDING")
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([indexKey, sourceType, sourceReferenceId, checksum])
  @@index([indexKey, status])
}

model AIEmbeddingRecord {
  id                 String   @id @default(uuid())
  indexKey           String
  sourceReferenceId  String
  chunkKey           String
  chunkText          String
  embeddingRef       String
  modelKey           String
  dimensions         Int
  checksum           String
  metadata           Json?
  createdAt          DateTime @default(now())

  @@unique([indexKey, sourceReferenceId, chunkKey, checksum])
  @@index([indexKey, modelKey])
}

model AIIndexingRunRecord {
  id                 String   @id @default(uuid())
  publicId           String   @unique
  indexKey           String
  sourceReferenceId  String
  status             String
  chunks             Int      @default(0)
  embeddedChunks     Int      @default(0)
  errorMessage       String?
  createdAt          DateTime @default(now())
  completedAt        DateTime?

  @@index([indexKey, status, createdAt])
  @@index([sourceReferenceId])
}

model AIIncidentEventRecord {
  id                String   @id @default(uuid())
  incidentPublicId  String
  action            String
  actorReferenceId  String?
  note               String?
  createdAt          DateTime @default(now())

  @@index([incidentPublicId, createdAt])
}

// --- Phase 18: Enterprise Student Tools ---
model StudentToolDefinitionRecord {
  id                      String   @id @default(uuid())
  toolKey                 String   @unique
  nameAr                  String
  nameEn                  String
  descriptionAr           String   @db.Text
  descriptionEn           String   @db.Text
  category                String
  executionType           String
  implementationPriority  String
  desiredLaunchVisibility String
  visibility              String
  implementationStatus    String
  lifecycle               String
  availability            Json
  featureFlags            Json
  rateLimitPolicy         Json
  aiCapabilityKey         String?
  outputType              String
  supportedLocales        Json
  estimatedMinutes        Int
  tags                     Json
  iconAssetId              String?
  owner                    String
  launchOrder              Int
  inputSchema              Json
  outputSchema             Json
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  versions                 StudentToolVersionRecord[]
  dependencies             StudentToolDependencyRecord[]
  executions               StudentToolExecutionRecord[]
  @@index([category, visibility, launchOrder])
  @@index([implementationStatus, lifecycle])
}

model StudentToolVersionRecord {
  id                  String   @id @default(uuid())
  definitionId        String
  semanticVersion     String
  inputSchemaVersion  String
  outputSchemaVersion String
  releaseDate         DateTime
  changeNote          String
  status              String
  createdAt           DateTime @default(now())
  definition          StudentToolDefinitionRecord @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  @@unique([definitionId, semanticVersion])
  @@index([definitionId, status])
}

model StudentToolDependencyRecord {
  id            String   @id @default(uuid())
  definitionId  String
  phase         String
  type          String
  required      Boolean
  capabilityKey String?
  description   String
  definition    StudentToolDefinitionRecord @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  @@index([definitionId, required])
}

model StudentToolExecutionRecord {
  id                    String   @id @default(uuid())
  executionId           String   @unique
  definitionId          String
  toolVersion            String
  status                 String
  consumerType           String
  studentReferenceHash   String?
  anonymousSessionHash   String?
  idempotencyKeyHash     String?
  correlationId          String
  traceId                String
  aiExecutionReference   String?
  dependencyStatus       Json?
  durationMs             Int?
  errorCode              String?
  safeUsageMetadata      Json?
  isTest                 Boolean  @default(false)
  startedAt              DateTime @default(now())
  completedAt            DateTime?
  definition             StudentToolDefinitionRecord @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  @@index([definitionId, status, startedAt])
  @@unique([definitionId, idempotencyKeyHash])
  @@index([correlationId])
  @@index([traceId])
}

// --- Phase 19: Enterprise Finance & Payments (all monetary values are exact minor-unit strings) ---
model FinanceInvoiceRecord {
  id String @id @default(uuid())
  publicId String @unique
  invoiceNumber String @unique
  correlationId String
  // W4: legacy rows remain nullable until controlled GS19 backfill; all new writes populate both fields.
  idempotencyKeyHash String? @unique
  requestFingerprint String?
  originDomain String
  originReferenceId String
  studentReferenceId String?
  payerReferenceId String?
  status String
  currencyCode String
  scale Int
  totalMinorUnits String
  dueMinorUnits String
  lineItems Json
  dueDate DateTime?
  issuedAt DateTime?
  paidAt DateTime?
  voidedAt DateTime?
  version Int @default(1)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments FinancePaymentRecord[]
  @@index([status, dueDate])
  @@index([studentReferenceId, createdAt])
  @@index([originDomain, originReferenceId])
}

model FinancePaymentRecord {
  id String @id @default(uuid())
  publicId String @unique
  invoiceId String
  idempotencyKeyHash String @unique
  currencyCode String
  scale Int
  amountMinorUnits String
  status String
  paymentMethod String
  gatewayProvider String?
  gatewayReference String?
  safeMaskedMetadata Json?
  failureReason String?
  capturedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoice FinanceInvoiceRecord @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  attempts FinancePaymentAttemptRecord[]
  @@index([invoiceId, status])
  @@unique([gatewayProvider, gatewayReference])
}

model FinancePaymentAttemptRecord {
  id String @id @default(uuid())
  paymentId String
  sequence Int
  status String
  gatewayReference String?
  safeFailureCode String?
  createdAt DateTime @default(now())
  payment FinancePaymentRecord @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  @@unique([paymentId, sequence])
  @@index([paymentId, createdAt])
}

model FinancialAccountRecord {
  id String @id @default(uuid())
  publicId String @unique
  ownerReferenceId String
  type String
  currencyCode String
  scale Int
  version Int @default(1)
  active Boolean @default(true)
  systemManaged Boolean @default(false)
  createdAt DateTime @default(now())
  entries FinancialLedgerEntryRecord[]
  wallet FinanceWalletRecord?
  @@unique([ownerReferenceId, type, currencyCode])
}

model FinancialTransactionRecord {
  id String @id @default(uuid())
  publicId String @unique
  correlationId String
  businessReferenceType String
  businessReferenceId String
  idempotencyKeyHash String @unique
  currencyCode String
  scale Int
  reversalOfId String? @unique
  createdBy String
  createdAt DateTime @default(now())
  entries FinancialLedgerEntryRecord[]
  reversalOf FinancialTransactionRecord? @relation("FinancialTransactionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal FinancialTransactionRecord? @relation("FinancialTransactionReversal")
  @@index([correlationId])
  @@index([businessReferenceType, businessReferenceId])
}

model FinancialLedgerEntryRecord {
  id String @id @default(uuid())
  transactionId String
  accountId String
  direction String
  amountMinorUnits String
  currencyCode String
  scale Int
  sequence Int
  memo String?
  createdAt DateTime @default(now())
  transaction FinancialTransactionRecord @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account FinancialAccountRecord @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@unique([transactionId, sequence])
  @@index([accountId, createdAt])
}

model FinanceWalletRecord {
  id String @id @default(uuid())
  publicId String @unique
  ownerReferenceId String
  accountId String @unique
  currencyCode String
  scale Int
  status String
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  holds FinanceWalletHoldRecord[]
  account FinancialAccountRecord @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([ownerReferenceId, status])
}

model FinanceWalletHoldRecord {
  id String @id @default(uuid())
  publicId String @unique
  walletId String
  amountMinorUnits String
  currencyCode String
  scale Int
  status String
  businessReferenceId String
  idempotencyKeyHash String @unique
  expiresAt DateTime?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  wallet FinanceWalletRecord @relation(fields: [walletId], references: [id], onDelete: Restrict)
  @@index([walletId, status])
}

model FinanceExchangeRateRecord {
  id String @id @default(uuid())
  publicId String @unique
  sourceCurrencyCode String
  targetCurrencyCode String
  rateNumerator String
  rateDenominator String
  source String
  providerReference String?
  approved Boolean @default(false)
  makerId String?
  approvalId String? @unique
  effectiveFrom DateTime
  effectiveTo DateTime?
  marginBasisPoints Int @default(0)
  createdAt DateTime @default(now())
  @@index([sourceCurrencyCode, targetCurrencyCode, approved, effectiveFrom])
}

model FinanceTransferRecord {
  id String @id @default(uuid())
  publicId String @unique
  sourceWalletId String
  destinationReferenceId String
  // W4: nullable only for pre-remediation rows pending GS19 reconciliation/backfill.
  destinationCurrencyCode String?
  sourceCurrencyCode String
  sourceScale Int
  sourceAmountMinorUnits String
  targetCurrencyCode String?
  targetScale Int?
  targetAmountMinorUnits String?
  rateId String?
  feeAmountMinorUnits String?
  feePolicyReference String?
  bankProvider String?
  bankProviderReference String? @unique
  providerStatus String?
  providerFailureCode String?
  settlementTransactionId String? @unique
  reversalTransactionId String? @unique
  status String
  makerId String
  correlationId String
  idempotencyKeyHash String @unique
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([sourceWalletId, createdAt])
}

model FinanceApprovalRecord {
  id String @id @default(uuid())
  publicId String @unique
  actionType String
  targetReferenceId String
  amountMinorUnits String?
  currencyCode String?
  scale Int?
  makerId String
  requiredApprovals Int
  // W4: legacy approvals are intentionally non-executable until backfilled/recreated.
  payloadHash String?
  policyReference String?
  consumedAt DateTime?
  status String
  expiresAt DateTime?
  createdAt DateTime @default(now())
  decisions FinanceApprovalDecisionRecord[]
  @@index([status, createdAt])
  @@index([targetReferenceId])
}

model FinanceApprovalDecisionRecord {
  id String @id @default(uuid())
  approvalId String
  approverId String
  decision String
  reason String?
  decidedAt DateTime @default(now())
  approval FinanceApprovalRecord @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  @@unique([approvalId, approverId])
}

model FinanceRefundRecord {
  id String @id @default(uuid())
  publicId String @unique
  paymentId String
  amountMinorUnits String
  currencyCode String
  scale Int
  reason String
  status String
  makerId String
  approvalId String?
  gatewayProvider String?
  gatewayReference String?
  failureCode String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@index([paymentId, status])
}

model FinanceDocumentRecord {
  id String @id @default(uuid())
  publicId String @unique
  type String
  invoiceId String
  paymentId String?
  amountMinorUnits String
  currencyCode String
  scale Int
  reason String?
  issuedBy String
  issuedAt DateTime @default(now())
  @@index([invoiceId, type])
}

model FinanceInstallmentPlanRecord {
  id String @id @default(uuid())
  publicId String @unique
  invoiceId String @unique
  totalMinorUnits String
  currencyCode String
  scale Int
  status String
  schedule Json
  createdAt DateTime @default(now())
}

model FinanceCommissionRecord {
  id String @id @default(uuid())
  publicId String @unique
  recipientReferenceId String
  sourcePaymentId String
  amountMinorUnits String
  currencyCode String
  scale Int
  status String
  policyReference String
  // W4: legacy commission rows are reconciled in GS19 before this can become required.
  calculationBasisPoints Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([sourcePaymentId, recipientReferenceId, policyReference])
  @@index([recipientReferenceId, status])
}

model FinanceEstimateRecord {
  id String @id @default(uuid())
  publicId String @unique
  subjectReferenceId String?
  displayCurrencyCode String
  scale Int
  totalMinorUnits String
  lines Json
  generatedAt DateTime @default(now())
  @@index([subjectReferenceId, generatedAt])
}
