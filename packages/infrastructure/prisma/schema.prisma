  nodes          CmsNavigationNode[]

  @@unique([siteIdentifier, locale, locationKey])
  @@index([siteIdentifier, locale, status])
}

model CmsNavigationNode {
  id              String   @id @default(uuid())
  menuId          String
  parentNodeId    String?
  displayText     String
  targetType      String
  targetValue     String
  sortOrder       Int      @default(0)
  openInNewWindow Boolean  @default(false)
  metadata        Json?

  menu CmsNavigationMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId, parentNodeId, sortOrder])
}

model CmsBlockSchema {
  id              String   @id @default(uuid())
  key             String
  version         Int
  nameAr          String
  nameEn          String
  fieldSchema     Json
  localizedFields Json
  assetFields     Json
  status          String   @default("ACTIVE")
  createdBy       String
  createdAt       DateTime @default(now())

  blocks CmsContentBlock[]

  @@unique([key, version])
  @@index([status, key])
}

model CmsContentBlock {
  id             String   @id @default(uuid())
  publicId       String   @unique
  siteIdentifier String
  locale         String
  schemaId       String
  name           String
  payload        Json
  status         String   @default("DRAFT")
  version        Int      @default(1)
  updatedBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  schema CmsBlockSchema @relation(fields: [schemaId], references: [id], onDelete: Restrict)

  @@index([siteIdentifier, locale, status])
  @@index([schemaId])
}

model CmsAnnouncement {
  id             String   @id @default(uuid())
  publicId       String   @unique
  siteIdentifier String
  locale         String
  title          String
  body           String
  urgency        String
  audience       String?
  startsAt       DateTime
  expiresAt      DateTime?
  status         String   @default("DRAFT")
  version        Int      @default(1)
  createdBy      String
  approvedBy     String?
  publishedAt    DateTime?
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([siteIdentifier, locale, status, startsAt, expiresAt])
}

model CmsScheduledJob {
  id                 String   @id @default(uuid())
  localizedContentId String
  jobType             String
  scheduledAt         DateTime
  status              String   @default("PENDING")
  attemptCount        Int      @default(0)
  idempotencyKey      String   @unique
  failureCode         String?
  completedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([localizedContentId, jobType])
}

// --- Identity Foundation ---

model IdentityRecord {
