  region                 String?
  subregion              String?
  defaultCurrencyCode    String?
  defaultLanguageCode    String?
  callingCode            String?
  flagAssetId            String?
  isActive               Boolean                      @default(true)
  metadata               Json?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  universities           University[]
