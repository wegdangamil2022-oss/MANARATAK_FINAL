{
  "name": "manaratak-2.0-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "bootstrap": "npm install && npm run build",
    "dev": "DISABLE_HMR=true npm run dev -w @manaratak/web",
    "dev:admin": "npm run dev -w @manaratak/admin",
    "build": "npm run build --workspaces --if-present",
    "build:cached": "turbo run build",
    "start": "npm run start -w @manaratak/api",
    "lint": "eslint .",
    "quality:source": "node scripts/quality/verify-source-quality.mjs",
    "quality:source:baseline": "node scripts/quality/verify-source-quality.mjs --write-baseline",
    "w0:verify": "node scripts/verify-w0-source.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules dist",
    "test": "vitest run --config vitest.config.ts",
    "test:cached": "turbo run test",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:database": "vitest run --config vitest.database.config.ts",
    "db:generate": "prisma generate --schema=packages/infrastructure/prisma/schema.prisma",
    "db:push": "prisma db push --schema=packages/infrastructure/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/infrastructure/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=packages/infrastructure/prisma/schema.prisma",
    "reference:countries:dry-run": "tsx scripts/dry-run-reference-countries.ts",
    "reference:geography:dry-run": "tsx scripts/dry-run-reference-geography.ts",
    "universities:stage1:dry-run": "tsx scripts/dry-run-university-stage1.ts",
    "universities:stage2:dry-run": "tsx scripts/dry-run-university-stage2-enrichment.ts",
    "universities:later-stage:dry-run": "tsx scripts/dry-run-university-later-stage.ts",
    "universities:changes:inspect": "tsx scripts/university-import-change-set.ts inspect",
    "universities:changes:commit": "tsx scripts/university-import-change-set.ts commit",
    "universities:changes:rollback": "tsx scripts/university-import-change-set.ts rollback",
    "outbox:verify": "tsx scripts/verify-transactional-outbox.ts",
    "phase15:verify": "node scripts/verify-phase15-source.mjs",
    "phase16:verify": "node scripts/verify-phase16-source.mjs",
    "phase15-16:closure:verify": "node scripts/verify-phase15-phase16-closure.mjs",
    "phase17:verify": "node scripts/verify-phase17-source.mjs",
    "phase18:verify": "node scripts/verify-phase18-source.mjs",
    "phase19:verify": "node scripts/verify-phase19-source.mjs",
    "stage3:degree-taxonomy:verify": "node scripts/verify-taxonomy-degree-source.mjs",
    "stage3:tests:verify": "node scripts/verify-international-test-source-baseline.mjs",
    "stage3:majors:verify": "node scripts/verify-major-source-identities.mjs",
    "stage3:verify": "npm run stage3:degree-taxonomy:verify && npm run stage3:tests:verify && npm run stage3:majors:verify",
    "translation:schema:verify": "tsx scripts/verify-translation-schema-source.ts",
    "translation:quality:source": "tsx scripts/verify-translation-quality-source.ts",
    "translation:test": "vitest run --config vitest.config.ts tests/translation/translation-quality-gates.spec.ts packages/shared/tests/localization/locale.spec.ts packages/application/tests/translation-import/TranslationImportPreparationService.spec.ts packages/application/tests/translation-import/TranslationImportTransferService.spec.ts",
    "translation:ci": "npm run translation:schema:verify && npm run translation:quality:source && npm run translation:test",
    "web:sitemap:generate": "tsx scripts/generate-localized-public-sitemap.ts",
    "db:remediation:plan": "tsx scripts/db-remediation-gate.ts plan",
    "db:remediation:status": "tsx scripts/db-remediation-gate.ts status",
    "db:remediation:baseline": "tsx scripts/db-remediation-gate.ts baseline",
    "db:remediation:dry-run": "tsx scripts/db-remediation-gate.ts migration-dry-run",
    "db:remediation:rollback-plan": "tsx scripts/db-remediation-gate.ts rollback-plan",
    "db:remediation:deploy": "tsx scripts/db-remediation-gate.ts deploy",
    "verify:local": "npm run quality:source && npm run typecheck && npm run lint && npm run build && npm run test && npm run e2e",
    "typecheck": "tsc -b",
    "git:validate:commit": "node scripts/git/validate-commit-message.mjs",
    "git:validate:branch": "node scripts/git/validate-branch-name.mjs",
    "e2e": "playwright test --config=apps/web/playwright.config.ts",
    "test:coverage": "vitest run --coverage",
    "postinstall": "npm run db:generate",
    "w1:verify": "node scripts/verify-w1-source.mjs",
    "w2:verify": "node scripts/verify-w2-source.mjs",
    "w3:verify": "node scripts/verify-w3-source.mjs",
    "w4:verify": "node scripts/verify-w4-source.mjs",
    "w5:verify": "node scripts/verify-w5-source.mjs",
    "w6:verify": "node scripts/verify-w6-source.mjs",
    "w7:verify": "node scripts/verify-w7-source.mjs",
    "w8:verify": "node scripts/verify-w8-source.mjs",
    "w9:verify": "node scripts/verify-w9-source.mjs",
    "w10:verify": "node scripts/verify-w10-source.mjs",
    "w11:verify": "node scripts/verify-w11-source.mjs",
    "w12:verify": "node scripts/verify-w12-source.mjs",
    "w13:verify": "node scripts/verify-w13-source.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "iso-3166-2": "^1.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "redis": "^6.2.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.0.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "turbo": "^2.10.7",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": ">=10.9.0 <11"
  }
}
