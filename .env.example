# --- ENVIRONMENT CONFIGURATION EXAMPLE (.env.example) ---
# All secrets and environment variables must be documented here.
# Production & Staging: Mandatory values MUST be provided in the environment.
# Development & Test: Safe local defaults are provided by the configuration layer.

# --- SECURITY & SECRETS (REQUIRED IN PRODUCTION / STAGING) ---

# JWT Secret: Used for signing and verifying API authentication tokens.
# Production/Staging: REQUIRED (Minimum 32 characters long).
# Development/Test Default: Provided automatically by AppConfig.
JWT_SECRET=your-32-character-jwt-secret-placeholder

# Session Secret: Used for session encryption and signing.
# Production/Staging: REQUIRED (Minimum 32 characters long).
# Development/Test Default: Provided automatically by AppConfig.
SESSION_SECRET=your-32-character-session-secret-placeholder

# CSRF Secret: Used for anti-CSRF token HMAC signing.
# Production/Staging: REQUIRED (Minimum 32 characters long).
# Development/Test Default: Provided automatically by AppConfig.
CSRF_SECRET=your-32-character-csrf-secret-placeholder

# Admin access always uses authenticated identities and persisted RBAC.
ADMIN_AUTH_MODE=strict


# --- DATABASE & INFRASTRUCTURE ---

# Database Connection URL: PostgreSQL connection string in production/staging.
# Production/Staging: REQUIRED (Must be a non-local HTTPS/PostgreSQL URL).
# Development/Test Default: 'file:./dev.db'.
DATABASE_URL=postgresql://user:password@postgres-host:5432/manaratak_db

# Redis Connection URL: Used for queue management and distributed rate limiting cache.
# Production/Staging: OPTIONAL (If unset, in-memory rate limiting and queue fallback are used).
# Development/Test Default: 'redis://localhost:6379'.
REDIS_URL=redis://redis-host:6379


# --- NETWORKING & CORS ---

# Public Application Base URL: API base URL for external clients.
# Production/Staging: REQUIRED (Must start with https://).
# Development/Test Default: 'http://localhost:3000'.
API_BASE_URL=https://api.manaratak.org

# CORS Allowed Origin: Web application frontend origin URL.
# Production/Staging: REQUIRED (Wildcards '*' are strictly forbidden).
# Development/Test Default: 'http://localhost:3000'.
CORS_ORIGIN=https://app.manaratak.org


# --- OPTIONAL RUNTIME CONFIGURATION ---

# Logging level: trace, debug, info, warn, error. Defaults to 'info'.
LOG_LEVEL=info

# OpenTelemetry Service Name for performance monitoring and trace tracking.
OTEL_SERVICE_NAME=manaratak-api

# Content Security Policy (CSP): Set to true to enable strict security headers.
SECURITY_CSP_ENABLED=true

# Rate limiting settings:
SECURITY_RATE_LIMIT_MAX=100
SECURITY_RATE_LIMIT_WINDOW_MS=60000

# Local Storage root path for temporary file processing.
STORAGE_BASE_PATH=./storage


# --- FRONTEND ENVIRONMENT VARIABLES (VITE) ---

# Admin Application Routing URL.
VITE_ADMIN_URL=http://localhost:3001

# Public Web Application URL used by admin deep links.
VITE_PUBLIC_WEB_URL=http://localhost:3000

# Public Web Application Base API Endpoint override.
VITE_API_URL=/api/v1
